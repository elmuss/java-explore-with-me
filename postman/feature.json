							"  pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Комментарий должен содержать поля: id, text, eventId, authorId, created\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"\r",
							"    pm.expect(responseData).to.be.an('object');\r",
